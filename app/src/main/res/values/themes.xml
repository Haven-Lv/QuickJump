<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- DayNight：跟随系统深色模式自动切换 -->
    <style name="Theme.QuickJump" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- 内容绘制到系统栏后面，由代码按 insets 补内边距 -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">@bool/is_light_theme</item>
        <item name="android:windowLightNavigationBar">@bool/is_light_theme</item>
        <!-- 启动瞬间的窗口底色与首页一致，减少白闪 -->
        <item name="android:windowBackground">@drawable/bg_screen</item>
        <!-- 关闭系统强制反色，深色由 values-night 自行提供 -->
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
