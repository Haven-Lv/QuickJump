<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.QuickJump" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- 状态栏与页面渐变顶部同色，避免出现一条色带 -->
        <item name="android:statusBarColor">#FAFBFF</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- 启动瞬间的窗口底色与首页一致，减少白闪 -->
        <item name="android:windowBackground">@drawable/bg_screen</item>
    </style>
</resources>
