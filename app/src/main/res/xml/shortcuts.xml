<?xml version="1.0" encoding="utf-8"?>
<!--
    桌面长按 App 图标弹出的快捷菜单：只放 3 个身份码入口。
    其余入口（淘宝待取快递 / 拼多多待取快递 / 抖音待取快递）打开 App 后使用。
    每个快捷方式显式启动本 App 的 MainActivity 并附带 jump_target 参数，
    由 MainActivity 统一做多级回退跳转，目标链接在其 ENTRIES 中维护。
-->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">

    <shortcut
        android:shortcutId="cainiao_code"
        android:enabled="true"
        android:icon="@drawable/ic_cainiao"
        android:shortcutShortLabel="@string/shortcut_cainiao"
        android:shortcutLongLabel="@string/shortcut_cainiao_long">
        <intent
            android:action="com.chuhe.quickjump.JUMP"
            android:targetPackage="com.chuhe.quickjump"
            android:targetClass="com.chuhe.quickjump.MainActivity">
            <extra
                android:name="jump_target"
                android:value="cainiao" />
        </intent>
    </shortcut>

    <shortcut
        android:shortcutId="taobao_code"
        android:enabled="true"
        android:icon="@drawable/ic_taobao"
        android:shortcutShortLabel="@string/shortcut_taobao"
        android:shortcutLongLabel="@string/shortcut_taobao_long">
        <intent
            android:action="com.chuhe.quickjump.JUMP"
            android:targetPackage="com.chuhe.quickjump"
            android:targetClass="com.chuhe.quickjump.MainActivity">
            <extra
                android:name="jump_target"
                android:value="taobao" />
        </intent>
    </shortcut>

    <shortcut
        android:shortcutId="pdd_code"
        android:enabled="true"
        android:icon="@drawable/ic_pdd"
        android:shortcutShortLabel="@string/shortcut_pdd"
        android:shortcutLongLabel="@string/shortcut_pdd_long">
        <intent
            android:action="com.chuhe.quickjump.JUMP"
            android:targetPackage="com.chuhe.quickjump"
            android:targetClass="com.chuhe.quickjump.MainActivity">
            <extra
                android:name="jump_target"
                android:value="pdd" />
        </intent>
    </shortcut>

</shortcuts>
